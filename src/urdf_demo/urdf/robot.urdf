<?xml version="1.0"?>
<robot name="my_robot">

  <!-- ========================= -->
  <!-- Main robot body           -->
  <!-- ========================= -->

  <link name="base_link">

    <!-- What the robot looks like -->
    <visual>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </visual>

    <!-- What the robot collides with -->
    <collision>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </collision>

    <!-- Physical properties -->
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.1875"
        ixy="0.0"
        ixz="0.0"
        iyy="0.4542"
        iyz="0.0"
        izz="0.5667"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Sensor body               -->
  <!-- ========================= -->

  <link name="sensor_link">

    <!-- What the sensor looks like -->
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.2"/>
      </geometry>
    </visual>

    <!-- What the sensor collides with -->
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.2"/>
      </geometry>
    </collision>

    <!-- Physical properties -->
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.0029"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0029"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Connect sensor to body    -->
  <!-- ========================= -->

  <joint name="sensor_joint" type="fixed">

    <parent link="base_link"/>
    <child link="sensor_link"/>

    <origin xyz="0 0 0.25" rpy="0 0 0"/>

  </joint>
  <!-- Left wheel -->
  <link name="left_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.00307917"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00307917"
        iyz="0.0"
        izz="0.005625"/>
    </inertial>

  </link>

  <!-- Left wheel joint -->
  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.35 -0.05" rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>
  <!-- Right wheel -->
  <link name="right_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.00307917"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00307917"
        iyz="0.0"
        izz="0.005625"/>
    </inertial>

  </link>

  <!-- Right wheel joint -->
  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.35 -0.05" rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>
<gazebo>
  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">

    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>

    <wheel_separation>0.7</wheel_separation>
    <wheel_diameter>0.3</wheel_diameter>

    <max_wheel_torque>20</max_wheel_torque>
    <max_wheel_acceleration>10</max_wheel_acceleration>

    <command_topic>cmd_vel</command_topic>
    <odometry_topic>odom</odometry_topic>

    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>

    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>true</publish_wheel_tf>

  </plugin>
</gazebo>


</robot>
