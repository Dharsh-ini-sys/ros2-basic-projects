<?xml version="1.0"?>
<robot name="my_robot">

  <!-- Main robot body -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </visual>
  </link>

  <!-- Sensor body -->
  <link name="sensor_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.2"/>
      </geometry>
    </visual>
  </link>

  <!-- Connect sensor to robot body -->
  <joint name="sensor_joint" type="fixed">

    <parent link="base_link"/>
    <child link="sensor_link"/>

    <origin xyz="0 0 0.25" rpy="0 0 0"/>

  </joint>

</robot>
